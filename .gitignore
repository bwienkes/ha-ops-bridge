# ---------------------------------------------------------------------------
# Python bytecode / caches
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.pytest_cache_tmp/
.cache/
*.cache
node_modules/

# Build / packaging output (never publish)
build/
dist/
*.egg-info/
*.whl
*.tar.gz
*.zip
artifacts/

# Local env / secret material (never commit real values)
*.env
.env
.env.*
*.local
*.pem
*.key
*.ppk
*.p12
credentials*.txt
*.service-account*.json
secrets.yaml
secrets/

# Receipts / run artifacts / local audit evidence (never publish)
*.receipt.json
*.receipt
.receipts/
receipts/
audit-receipt.json
*.audit.json
*.audit.jsonl

# Screenshots / local captures (never publish)
*.screenshot.png
*.screenshot.jpg
screenshots/
captures/
*.snap.png

# Logs
*.log
*.log.*
logs/

# Local state / editor & OS noise
*.state.json
.local/
.state/
.DS_Store
Thumbs.db
*.bak
*.orig

# Test-run captures (never publish these; they can embed local paths)
_*.txt
.testtmp/
